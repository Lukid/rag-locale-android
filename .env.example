# .env.example — template annotato (nessun valore reale, da non committare con segreti)
#
# Questo progetto Android non ha ancora riferimenti a variabili d'ambiente.
# Su Android i segreti NON vanno in .env: usa `local.properties` (ignorato da git)
# o i secret della CI. Esempi tipici:
#
#   local.properties
#     # percorso SDK (generato da Android Studio, non committare)
#     sdk.dir=/Users/<tu>/Library/Android/sdk
#     # Client ID dell'OAuth app HuggingFace per il login in-app (download dei modelli gated,
#     # es. l'embedder). Si ottiene su https://huggingface.co/settings/oauth/apps con
#     # Redirect URI it.netseven.raglocale://oauth2callback e scope read-repos. Se assente, il
#     # login HF è disattivato ma i modelli pubblici restano scaricabili (degrado con grazia).
#     hfOauthClientId=
#     # eventuali chiavi di firma o API key in chiaro SOLO in locale:
#     # MAPS_API_KEY=...
#
#   keystore.properties (per la firma di release, ignorato da git)
#     # storeFile=...
#     # storePassword=...
#     # keyAlias=...
#     # keyPassword=...
#
# Quando aggiungi variabili d'ambiente lette dal codice, elencale qui SENZA valori:
#
# ESEMPIO_API_KEY=
# ESEMPIO_ENDPOINT=
